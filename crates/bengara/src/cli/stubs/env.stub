APP_NAME={{name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# 鍵（64 文字以上）。`cargo artisan key:generate` で作る。作り直すとセッションと暗号文が読めなくなる
APP_KEY=

# セッション（file / memory）。LIFETIME は分
SESSION_DRIVER=file
SESSION_LIFETIME=120

# データベース（sqlite / mysql / mariadb / pgsql）。ドライバの機能フラグが要る
#   sqlite -> "sqlite" / mysql・mariadb -> "mysql" / pgsql -> "postgres"
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# mysql / pgsql のとき。`#` を含む値は引用符で囲む（DB_PASSWORD="p#ss"）
# DB_HOST=127.0.0.1
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=
# DB_MAX_CONNECTIONS=5
# DB_URL=

# テスト用のデータベース。テストは表を全部消すので、mysql / pgsql では必ず別の名前にする
DB_TEST_DATABASE=:memory:

APP_HOST=127.0.0.1
APP_PORT=8000

# ログ。細かさは RUST_LOG、出し先は LOG_CHANNEL（daily / stdout）、残す日数は LOG_DAILY_DAYS（0 は消さない）
# RUST_LOG=info
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14

# パスワード。開発中にログインが遅ければ回数を下げる（本番では消すか 240000 以上）
# argon2id には機能フラグ "argon2" が要る
# HASH_ITERATIONS=10000
# HASH_DRIVER=pbkdf2

# キャッシュ（file / memory）
CACHE_DRIVER=file

# メール（log / array / smtp）。smtp には機能フラグ "mail" が要る
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# smtp のとき
# MAIL_HOST=127.0.0.1
# MAIL_PORT=
# MAIL_ENCRYPTION=starttls
# MAIL_SCHEME=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_EHLO_NAME=
# MAIL_TIMEOUT=10

# 画面の言語（resources/lang/*.toml の名前）
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

# storage/ の場所（絶対パス）と、既定のファイル置き場（local / public）
# APP_STORAGE_PATH=
# STORAGE_DISK=local

# 停止の合図から、処理中のリクエストを待つ秒数（0 は無制限）
APP_SHUTDOWN_TIMEOUT=30

# 受け取る本文の上限（バイト）
# APP_MAX_BODY_BYTES=2097152

# 信頼する逆プロキシ（カンマ区切り）。前に nginx などを置くときだけ書く
# TRUSTED_PROXIES=

# WebSocket（機能フラグ "websocket"）。プロセスが 2 つ以上なら database にする
# BROADCAST_CONNECTION=memory
# WEBSOCKET_MAX_CONNECTIONS=10000
